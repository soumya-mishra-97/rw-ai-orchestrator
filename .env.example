# Copy to .env and fill in. Never commit .env.
# Anthropic key for live mode. Loaded into the process at startup and read only by
# the Anthropic SDK; it is never stored in our settings object or logged.
ANTHROPIC_API_KEY=

# --- runtime mode ---
SDLC_MODE=auto                    # auto (live if the key works, else demo) | live | demo
SDLC_VERIFY_CREDENTIALS=true      # one free models.retrieve call at startup
SDLC_DEMO_PLAYBACK_DELAY_S=0.6    # demo mode only: pause per step so progress is visible

# --- models (defaults shown) ---
SDLC_TIER1_MODEL=claude-haiku-4-5-20251001
SDLC_TIER2_MODEL=claude-sonnet-5
SDLC_TIER2_EFFORT=medium

# --- reliability engine ---
SDLC_MAX_RETRIES_PER_HANDOFF=2
SDLC_PASS_THRESHOLD=4.0
SDLC_CRITICAL_POLICY=fast_track   # or strict: escalate on any critical flag immediately

# --- cost levers (switch off to measure their effect) ---
SDLC_CONTEXT_POLICY=minimal       # or full_history
SDLC_ROUTING_POLICY=routed        # or all_tier2
SDLC_TIERED_EVALUATOR=true
SDLC_PROMPT_CACHING=true
SDLC_DETERMINISTIC_PREGATE=true

# --- QA code execution (runs LLM-written tests in a subprocess; keep off outside a sandbox) ---
SDLC_EXECUTE_GENERATED_CODE=false

# --- governance ---
SDLC_PII_BACKEND=regex            # or presidio (uv sync --extra pii)
SDLC_API_KEYS=                    # e.g. op-key-123:operator,rev-key-456:reviewer,aud-key-789:auditor
SDLC_DATA_DIR=var
